PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://farmer_user:farmer_password@localhost:5433/farmer_db?schema=public"
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=15m
ADMIN_REGISTRATION_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
SMS_PROVIDER=console
BUSINESS_TIMEZONE=Asia/Kolkata
# Orders for tomorrow close at this hour (0-24, 24 = no cut-off)
ORDER_CUTOFF_HOUR=21
TRUST_PROXY=0
# Comma-separated browser origins, e.g. the admin web app
CORS_ORIGINS=http://localhost:5173
UPLOADS_DIR=uploads
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# Copy to .env.production on the server and fill in every value. Never commit the copy.

# Public names; both DNS A records point at this server
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

# Database container
POSTGRES_USER=farmer
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=farmer
DATABASE_URL=postgresql://farmer:replace-with-a-long-random-password@postgres:5432/farmer?schema=public

NODE_ENV=production
PORT=3000
# Requests arrive through Caddy, one proxy hop
TRUST_PROXY=1
CORS_ORIGINS=https://admin.example.com

# Generate each with: openssl rand -base64 48
JWT_SECRET=
ADMIN_REGISTRATION_SECRET=

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=60
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Testers only: codes are written to `docker compose logs api` instead of sent.
# Set ALLOW_CONSOLE_SMS=false once a real SMS provider is added.
SMS_PROVIDER=console
ALLOW_CONSOLE_SMS=true

BUSINESS_TIMEZONE=Asia/Kolkata
ORDER_CUTOFF_HOUR=21
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
LOG_LEVEL=info

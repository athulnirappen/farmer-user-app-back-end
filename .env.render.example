# What the Render service needs. render.yaml sets everything else; enter these three in the
# Render dashboard when creating the Blueprint. Never commit real values.

# Supabase > Connect > Session pooler (IPv4). Replace [YOUR-PASSWORD].
# uselibpqcompat=true makes sslmode=require encrypt without checking Supabase's own CA.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

model User {
  id                String          @id @default(uuid())
  name              String?
  email             String?         @unique
  phone             String?         @unique
  passwordHash      String?
  phoneVerified     Boolean         @default(false)
  role              UserRole        @default(USER)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  buyerProfile      BuyerProfile?
  farmerProfile     FarmerProfile?
  refreshTokens     RefreshToken[]
  categoriesCreated Category[]
  orders            Order[]
  cartItems         CartItem[]
  addresses         Address[]
  adminActions      AdminAuditLog[]
}

model BuyerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FarmerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  farmName           String
  farmLocation       String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  products           Product[]
  orders             Order[]

  @@index([latitude, longitude])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  // The token issued when this one was rotated, so a retried refresh can be told from a stolen one
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenReplacement")

  @@unique([tokenHash])
  @@index([userId, revokedAt, expiresAt])
}

model OtpChallenge {
  id         String     @id @default(uuid())
  phone      String
  purpose    OtpPurpose
  name       String?
  email      String?
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, expiresAt])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  stock        Int
  unit         String
  farmId       String
  farmer       FarmerProfile @relation(fields: [farmId], references: [id])
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  isActive     Boolean       @default(true)
  // Set by an admin; unlike isActive, the farmer cannot undo it
  hiddenAt     DateTime?
  hiddenReason String?

  declarationVersion    String
  declarationAcceptedAt DateTime
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  orderItems            OrderItem[]
  cartItems             CartItem[]
  images                ProductImage[]

  @@index([categoryId])
  @@index([farmId])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

model Order {
  id             String         @id @default(uuid())
  orderGroupId   String
  buyerId        String
  buyer          User           @relation(fields: [buyerId], references: [id])
  farmId         String
  farmer         FarmerProfile  @relation(fields: [farmId], references: [id])
  status         OrderStatus    @default(PLACED)
  fulfilmentType FulfilmentType
  deliveryDate   DateTime       @db.Date
  timeSlot       String
  paymentMethod  PaymentMethod  @default(CASH_ON_DELIVERY)
  totalAmount    Decimal        @db.Decimal(10, 2)

  // Copied at checkout so later profile or farm edits don't change past orders
  contactName     String?
  contactPhone    String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  pincode         String?
  pickupLocation  String?
  pickupLatitude  Float?
  pickupLongitude Float?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([buyerId, createdAt])
  @@index([farmId, deliveryDate])
  @@index([orderGroupId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unit        String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id             String   @id @default(uuid())
  buyerId        String
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  // Price when the buyer last added or changed this item, so the cart can say the price has changed
  unitPriceAtAdd Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([buyerId, productId])
  @@index([productId])
}

// A user's saved delivery addresses; separate from a farm's own location
model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  line1     String
  line2     String?
  city      String
  pincode   String
  latitude  Float?
  longitude Float?
  // Exactly one per user once they have any; kept in step inside transactions
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per admin change, kept for accountability; never updated
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // key is where storage keeps the file; url is what clients load
  key       String
  url       String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}
